{
  "name": "b-livestats-handball",
  "productName": "B LiveStats Handball",
  "version": "1.1.3",
  "description": "Offline handball live statistics desktop app",
  "author": "B LiveStats",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MohammedGamalll/b-livestats-handball.git"
  },
  "sideEffects": false,
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "npm run electron:dev",
    "dev:web": "vite dev --open",
    "electron:dev": "concurrently -k \"vite dev --host 127.0.0.1 --port 8080\" \"wait-on -t 120000 http://127.0.0.1:8080 && electron .\"",
    "build": "vite build",
    "build:electron": "cross-env ELECTRON=1 vite build && node scripts/copy-renderer.mjs",
    "dist": "cross-env ELECTRON=1 vite build && node scripts/copy-renderer.mjs && electron-builder --win nsis --publish never",
    "dist:publish": "cross-env ELECTRON=1 vite build && node scripts/copy-renderer.mjs && node scripts/publish-update.cjs",
    "db:seed": "node scripts/create-database.cjs",
    "db:seed-teams": "node scripts/seed-demo-teams.cjs",
    "check:attribution": "node scripts/gk-attribution-check.cjs && node scripts/player-attribution-check.cjs",
    "icon:make": "node scripts/make-icon.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/router-plugin": "^1.167.28",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.7.7",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.blivestats.handball",
    "productName": "B LiveStats Handball",
    "copyright": "Copyright © B LiveStats",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/database.db",
        "to": "database.db"
      },
      {
        "from": "assets/site-config.json",
        "to": "site-config.json"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "electron-dist/renderer",
        "to": "renderer"
      }
    ],
    "asarUnpack": [
      "**/better-sqlite3/**",
      "**/*.node"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "B-LiveStats-Handball-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "MohammedGamalll",
      "repo": "b-livestats-handball",
      "releaseType": "release"
    }
  }
}
